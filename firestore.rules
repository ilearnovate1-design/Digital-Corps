rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Reusable Helper Functions
    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) ||
        (request.auth.token.email == 'jomaschools@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // Validation Blueprint for Minimal Participant Registration
    function isValidParticipant(data) {
      return data.keys().hasAll([
        'firstName',
        'surname',
        'contactMethod',
        'communityOptIn',
        'marketingConsent',
        'consentTimestamp',
        'campaignId',
        'registrationId',
        'createdAt'
      ]) && data.keys().hasOnly([
        'firstName',
        'surname',
        'contactMethod',
        'phone',
        'email',
        'stateCode',
        'engagementType',
        'platoon',
        'primarySkillTrack',
        'skillLevel',
        'deploymentState',
        'cdsGroupId',
        'cdsGroupName',
        'communityOptIn',
        'marketingConsent',
        'consentTimestamp',
        'campaignId',
        'registrationId',
        'createdAt'
      ]) &&
      data.firstName is string && data.firstName.size() >= 1 && data.firstName.size() <= 50 &&
      data.surname is string && data.surname.size() >= 1 && data.surname.size() <= 50 &&
      data.contactMethod in ['email', 'phone', 'both'] &&
      (!('email' in data) || (data.email is string && data.email.size() <= 100)) &&
      (!('phone' in data) || (data.phone is string && data.phone.size() <= 25)) &&
      (('email' in data && data.email.size() >= 5) || ('phone' in data && data.phone.size() >= 7)) &&
      (!('stateCode' in data) || (data.stateCode is string && data.stateCode.size() <= 20)) &&
      (!('engagementType' in data) || (data.engagementType in ['on_camp', 'post_camp'])) &&
      (!('platoon' in data) || (data.platoon is int && data.platoon >= 0 && data.platoon <= 10)) &&
      (!('primarySkillTrack' in data) || (data.primarySkillTrack is string && data.primarySkillTrack.size() <= 60)) &&
      (!('skillLevel' in data) || (data.skillLevel in ['beginner', 'intermediate', 'advanced', 'not_specified'])) &&
      (!('deploymentState' in data) || (data.deploymentState is string && data.deploymentState.size() <= 50)) &&
      (!('cdsGroupId' in data) || (data.cdsGroupId is string && data.cdsGroupId.size() <= 80)) &&
      (!('cdsGroupName' in data) || (data.cdsGroupName is string && data.cdsGroupName.size() <= 120)) &&
      data.communityOptIn is bool &&
      data.marketingConsent is bool &&
      data.consentTimestamp is string && data.consentTimestamp.size() <= 40 &&
      data.campaignId is string && data.campaignId.size() >= 3 && data.campaignId.size() <= 64 &&
      data.registrationId is string && data.registrationId.size() >= 6 && data.registrationId.size() <= 40 &&
      (data.createdAt == request.time || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 40));
    }

    // Validation Blueprint for CDS Group
    function isValidCDSGroup(data) {
      return data.keys().hasAll(['name', 'active', 'createdAt']) &&
        data.keys().hasOnly(['id', 'name', 'description', 'lga', 'state', 'meetingDay', 'active', 'createdAt', 'createdBy']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 80)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        (!('lga' in data) || (data.lga is string && data.lga.size() <= 80)) &&
        (!('state' in data) || (data.state is string && data.state.size() <= 50)) &&
        (!('meetingDay' in data) || (data.meetingDay is string && data.meetingDay.size() <= 80)) &&
        data.active is bool &&
        (data.createdAt == request.time || data.createdAt is string) &&
        (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 100));
    }

    // Validation Blueprint for Challenge Submission
    function isValidChallengeSubmission(data) {
      return data.keys().hasAll([
        'participantName',
        'solutionTitle',
        'solutionSummary',
        'campaignId',
        'createdAt'
      ]) && data.keys().hasOnly([
        'participantReference',
        'participantName',
        'platoon',
        'solutionTitle',
        'solutionSummary',
        'actionPlan30Days',
        'campaignId',
        'createdAt'
      ]) &&
      data.participantName is string && data.participantName.size() >= 2 && data.participantName.size() <= 100 &&
      data.solutionTitle is string && data.solutionTitle.size() >= 3 && data.solutionTitle.size() <= 120 &&
      data.solutionSummary is string && data.solutionSummary.size() >= 10 && data.solutionSummary.size() <= 1200 &&
      (!('participantReference' in data) || (data.participantReference is string && data.participantReference.size() <= 40)) &&
      (!('platoon' in data) || (data.platoon is int && data.platoon >= 0 && data.platoon <= 10)) &&
      (!('actionPlan30Days' in data) || (data.actionPlan30Days is string && data.actionPlan30Days.size() <= 1000)) &&
      data.campaignId is string && data.campaignId.size() >= 3 && data.campaignId.size() <= 64 &&
      (data.createdAt == request.time || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 40));
    }

    // Validation Blueprint for Admin Audit Log
    function isValidAdminAuditLog(data) {
      return data.keys().hasAll(['adminEmail', 'action', 'details', 'timestamp']) &&
        data.keys().hasOnly(['adminEmail', 'action', 'details', 'timestamp']) &&
        data.adminEmail is string && data.adminEmail.size() <= 100 &&
        data.action in ['CSV_EXPORT', 'REPORT_GENERATION', 'QUIZ_RESULT_INVALIDATION', 'MESSAGE_BROADCAST', 'DIRECT_MESSAGE_SENT', 'CDS_GROUP_CREATE', 'CDS_GROUP_UPDATE'] &&
        data.details is string && data.details.size() <= 500 &&
        data.timestamp is string;
    }

    // Validation Blueprint for Official Quiz Result
    function isValidQuizResult(resultId, data) {
      let participantPath = /databases/$(database)/documents/participants/$(data.participantId);
      return data.keys().hasAll([
        'participantId',
        'quizRoundId',
        'campaignId',
        'score',
        'totalQuestions',
        'qualifying',
        'platoon',
        'submittedAt',
        'status'
      ]) && data.keys().hasOnly([
        'participantId',
        'quizRoundId',
        'campaignId',
        'categoryId',
        'categoryName',
        'score',
        'totalQuestions',
        'qualifying',
        'platoon',
        'submittedAt',
        'status',
        'invalidationReason',
        'attemptId',
        'timeTakenSeconds'
      ]) &&
      (
        resultId == data.quizRoundId + '_' + data.participantId ||
        (('categoryId' in data) && resultId == data.quizRoundId + '_' + data.categoryId + '_' + data.participantId)
      ) &&
      exists(participantPath) &&
      data.participantId is string && data.participantId.size() >= 6 && data.participantId.size() <= 40 &&
      data.quizRoundId is string && data.quizRoundId.size() >= 3 && data.quizRoundId.size() <= 40 &&
      data.campaignId is string && data.campaignId.size() >= 3 && data.campaignId.size() <= 64 &&
      (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() <= 64)) &&
      (!('categoryName' in data) || (data.categoryName is string && data.categoryName.size() <= 100)) &&
      (!('attemptId' in data) || (data.attemptId is string && data.attemptId.size() <= 64)) &&
      (!('timeTakenSeconds' in data) || (data.timeTakenSeconds is int && data.timeTakenSeconds >= 0 && data.timeTakenSeconds <= 600)) &&
      data.score is int && data.score >= 0 && data.score <= 10 &&
      data.totalQuestions == 10 &&
      data.qualifying == (data.score >= 6) &&
      data.platoon is int && data.platoon >= 0 && data.platoon <= 10 &&
      (
        (!('platoon' in get(participantPath).data) && data.platoon == 0) ||
        ('platoon' in get(participantPath).data && data.platoon == get(participantPath).data.platoon)
      ) &&
      data.submittedAt is string && data.submittedAt.size() <= 40 &&
      data.status in ['unverified', 'verified'];
    }

    // Validation for Admin Result Status Update
    function isValidQuizResultUpdate(incomingData, existingData) {
      return incomingData.diff(existingData).affectedKeys().hasOnly(['status', 'invalidationReason']) &&
        incomingData.status in ['verified', 'invalidated', 'unverified'] &&
        (!('invalidationReason' in incomingData) || (incomingData.invalidationReason is string && incomingData.invalidationReason.size() <= 500));
    }

    // 2. Collection: /participants/{participantId}
    // Public blind-create only; READ is strictly RESTRICTED to verified admins.
    match /participants/{participantId} {
      allow create: if isValidId(participantId) && isValidParticipant(incoming());
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // 3. Collection: /challengeSubmissions/{submissionId}
    // Public blind-create only; READ is strictly RESTRICTED to verified admins.
    match /challengeSubmissions/{submissionId} {
      allow create: if isValidId(submissionId) && isValidChallengeSubmission(incoming());
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // 4. Collection: /adminAuditLogs/{logId}
    // Append-only for verified admins. No updates or deletes allowed.
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidAdminAuditLog(incoming());
      allow update, delete: if false;
    }

    // 5. Collection: /cdsGroups/{groupId}
    // Public read for selection; admin write for management.
    match /cdsGroups/{groupId} {
      allow read: if true;
      allow write: if isAdmin() && isValidCDSGroup(incoming());
    }

    // 6. Collection: /adminUsers/{adminId}
    match /adminUsers/{adminId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == adminId);
      allow write: if false;
    }

    // 7. Collection: /quizResults/{resultId}
    // Public creation allowed ONLY for registered participants with verified platoon link.
    // READ restricted to verified admins.
    // Public updates and deletes are strictly prohibited.
    // Admin update allowed exclusively to verify or invalidate results.
    match /quizResults/{resultId} {
      allow create: if isValidId(resultId) && isValidQuizResult(resultId, incoming());
      allow read: if isAdmin();
      allow update: if isAdmin() && isValidQuizResultUpdate(incoming(), existing());
      allow delete: if false;
    }

    // 8. Collection: /learningProgress/{progressId}
    // Format: ${courseId}_${participantId}
    // Participant can manage their own progress via deterministic ID; Admins can list for analytics.
    function isValidLearningProgress(progressId, data) {
      return data.keys().hasAll([
        'participantId',
        'courseId',
        'enrolledAt',
        'lastAccessedAt',
        'completedLessonIds',
        'courseStatus',
        'progressPercentage'
      ]) && data.keys().hasOnly([
        'participantId',
        'courseId',
        'participantName',
        'platoon',
        'stateCode',
        'enrolledAt',
        'lastAccessedAt',
        'lastAccessedLessonId',
        'completedLessonIds',
        'completedModuleIds',
        'completedCodingChallengeIds',
        'completedAiLabIds',
        'moduleCheckScores',
        'moduleCheckDetails',
        'finalAssessmentScore',
        'finalAssessmentBestScore',
        'finalAssessmentAttempts',
        'finalAssessmentPassed',
        'finalAssessmentVerificationToken',
        'finalAssessmentCompletedAt',
        'capstoneSubmissionId',
        'capstoneCompleted',
        'certificateEligible',
        'courseStatus',
        'progressPercentage',
        'completedAt'
      ]) &&
      progressId == data.courseId + '_' + data.participantId &&
      data.participantId is string && data.participantId.size() >= 4 && data.participantId.size() <= 64 &&
      data.courseId is string && data.courseId.size() >= 4 && data.courseId.size() <= 64 &&
      (!('participantName' in data) || (data.participantName is string && data.participantName.size() <= 100)) &&
      (!('platoon' in data) || (data.platoon is int && data.platoon >= 0 && data.platoon <= 10)) &&
      (!('stateCode' in data) || (data.stateCode is string && data.stateCode.size() <= 25)) &&
      data.enrolledAt is string && data.enrolledAt.size() <= 40 &&
      data.lastAccessedAt is string && data.lastAccessedAt.size() <= 40 &&
      (!('lastAccessedLessonId' in data) || (data.lastAccessedLessonId is string && data.lastAccessedLessonId.size() <= 64)) &&
      data.completedLessonIds is list && data.completedLessonIds.size() <= 50 &&
      (!('completedModuleIds' in data) || (data.completedModuleIds is list && data.completedModuleIds.size() <= 20)) &&
      (!('completedCodingChallengeIds' in data) || (data.completedCodingChallengeIds is list && data.completedCodingChallengeIds.size() <= 50)) &&
      (!('completedAiLabIds' in data) || (data.completedAiLabIds is list && data.completedAiLabIds.size() <= 50)) &&
      (!('moduleCheckScores' in data) || data.moduleCheckScores is map) &&
      (!('moduleCheckDetails' in data) || data.moduleCheckDetails is map) &&
      (!('finalAssessmentScore' in data) || (data.finalAssessmentScore is int && data.finalAssessmentScore >= 0 && data.finalAssessmentScore <= 100)) &&
      (!('finalAssessmentBestScore' in data) || (data.finalAssessmentBestScore is int && data.finalAssessmentBestScore >= 0 && data.finalAssessmentBestScore <= 100)) &&
      (!('finalAssessmentAttempts' in data) || (data.finalAssessmentAttempts is int && data.finalAssessmentAttempts >= 0 && data.finalAssessmentAttempts <= 1000)) &&
      (!('finalAssessmentPassed' in data) || data.finalAssessmentPassed is bool) &&
      (!('finalAssessmentVerificationToken' in data) || (data.finalAssessmentVerificationToken is string && data.finalAssessmentVerificationToken.size() <= 120)) &&
      (!('finalAssessmentCompletedAt' in data) || (data.finalAssessmentCompletedAt is string && data.finalAssessmentCompletedAt.size() <= 40)) &&
      (!('capstoneSubmissionId' in data) || (data.capstoneSubmissionId is string && data.capstoneSubmissionId.size() <= 128)) &&
      (!('capstoneCompleted' in data) || data.capstoneCompleted is bool) &&
      (!('certificateEligible' in data) || data.certificateEligible is bool) &&
      data.courseStatus in ['not_started', 'in_progress', 'completed'] &&
      data.progressPercentage is int && data.progressPercentage >= 0 && data.progressPercentage <= 100 &&
      (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 40));
    }

    match /learningProgress/{progressId} {
      allow create: if isValidId(progressId) && isValidLearningProgress(progressId, incoming());
      allow update: if isValidId(progressId) &&
        isValidLearningProgress(progressId, incoming()) &&
        incoming().participantId == existing().participantId &&
        incoming().courseId == existing().courseId;
      allow get: if isAdmin() || isValidId(progressId);
      allow list: if isAdmin();
      allow delete: if isAdmin();
    }

    // 9. Collection: /courseProjectSubmissions/{submissionId}
    // Participants save drafts & submit capstone projects; Admins can list, review, score, and feedback.
    function isValidProjectSubmission(data) {
      return data.keys().hasAll([
        'submissionId',
        'participantId',
        'participantName',
        'courseId',
        'courseTitle',
        'projectTitle',
        'projectDescription',
        'submissionStatus',
        'submittedAt'
      ]) && data.keys().hasOnly([
        'id',
        'submissionId',
        'submissionType',
        'moduleId',
        'participantId',
        'participantName',
        'participantCallUpNumber',
        'participantPlatoon',
        'platoon',
        'stateCode',
        'courseId',
        'courseTitle',
        'projectTitle',
        'projectDescription',
        'businessName',
        'targetCustomerSummary',
        'valueProposition',
        'githubRepoUrl',
        'liveAppUrl',
        'codeSnippet',
        'deliverablesChecklist',
        'supportingLinks',
        'uploadedAttachments',
        'artifactUrl',
        'submissionUrl',
        'submissionStatus',
        'status',
        'draftSavedAt',
        'reviewerFeedback',
        'coordinatorFeedback',
        'reviewedBy',
        'reviewedAt',
        'score',
        'rubricScores',
        'submittedAt',
        'updatedAt'
      ]) &&
      (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
      data.submissionId is string && data.submissionId.size() >= 6 && data.submissionId.size() <= 128 &&
      (!('submissionType' in data) || (data.submissionType in ['capstone', 'coding_assignment'])) &&
      (!('moduleId' in data) || (data.moduleId is string && data.moduleId.size() <= 64)) &&
      data.participantId is string && data.participantId.size() >= 4 && data.participantId.size() <= 64 &&
      data.participantName is string && data.participantName.size() >= 2 && data.participantName.size() <= 100 &&
      (!('participantCallUpNumber' in data) || (data.participantCallUpNumber is string && data.participantCallUpNumber.size() <= 40)) &&
      (!('participantPlatoon' in data) || (data.participantPlatoon is string && data.participantPlatoon.size() <= 40)) &&
      (!('platoon' in data) || (data.platoon is int && data.platoon >= 0 && data.platoon <= 10)) &&
      (!('stateCode' in data) || (data.stateCode is string && data.stateCode.size() <= 25)) &&
      data.courseId is string && data.courseId.size() >= 4 && data.courseId.size() <= 64 &&
      data.courseTitle is string && data.courseTitle.size() >= 2 && data.courseTitle.size() <= 120 &&
      data.projectTitle is string && data.projectTitle.size() >= 3 && data.projectTitle.size() <= 150 &&
      data.projectDescription is string && data.projectDescription.size() <= 5000 &&
      (data.submissionStatus == 'draft' || data.projectDescription.size() >= 10) &&
      (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 150)) &&
      (!('targetCustomerSummary' in data) || (data.targetCustomerSummary is string && data.targetCustomerSummary.size() <= 1000)) &&
      (!('valueProposition' in data) || (data.valueProposition is string && data.valueProposition.size() <= 1000)) &&
      (!('githubRepoUrl' in data) || (data.githubRepoUrl is string && data.githubRepoUrl.size() <= 500)) &&
      (!('liveAppUrl' in data) || (data.liveAppUrl is string && data.liveAppUrl.size() <= 500)) &&
      (!('codeSnippet' in data) || (data.codeSnippet is string && data.codeSnippet.size() <= 8000)) &&
      (!('deliverablesChecklist' in data) || data.deliverablesChecklist is map) &&
      (!('supportingLinks' in data) || (data.supportingLinks is list && data.supportingLinks.size() <= 15)) &&
      (!('uploadedAttachments' in data) || (data.uploadedAttachments is list && data.uploadedAttachments.size() <= 5)) &&
      (!('artifactUrl' in data) || (data.artifactUrl is string && data.artifactUrl.size() <= 500)) &&
      (!('submissionUrl' in data) || (data.submissionUrl is string && data.submissionUrl.size() <= 500)) &&
      data.submissionStatus in ['draft', 'submitted', 'under_review', 'approved', 'revision_requested', 'rejected'] &&
      (!('status' in data) || (data.status in ['draft', 'submitted', 'under_review', 'approved', 'revision_requested', 'rejected'])) &&
      (!('draftSavedAt' in data) || (data.draftSavedAt is string && data.draftSavedAt.size() <= 40)) &&
      (!('reviewerFeedback' in data) || (data.reviewerFeedback is string && data.reviewerFeedback.size() <= 2000)) &&
      (!('coordinatorFeedback' in data) || (data.coordinatorFeedback is string && data.coordinatorFeedback.size() <= 2000)) &&
      (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 100)) &&
      (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 40)) &&
      (!('score' in data) || (data.score is int && data.score >= 0 && data.score <= 100)) &&
      (!('rubricScores' in data) || data.rubricScores is map) &&
      data.submittedAt is string && data.submittedAt.size() <= 40 &&
      (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    match /courseProjectSubmissions/{submissionId} {
      allow create: if isValidId(submissionId) &&
        isValidProjectSubmission(incoming()) &&
        (
          submissionId == 'sub_' + incoming().courseId + '_' + incoming().participantId ||
          (
            ('moduleId' in incoming()) &&
            incoming().submissionType == 'coding_assignment' &&
            submissionId == 'sub_' + incoming().courseId + '_' + incoming().moduleId + '_' + incoming().participantId
          )
        ) &&
        incoming().submissionStatus in ['draft', 'submitted'] &&
        !('score' in incoming()) &&
        !('rubricScores' in incoming()) &&
        !('reviewerFeedback' in incoming()) &&
        !('coordinatorFeedback' in incoming()) &&
        !('reviewedBy' in incoming()) &&
        !('reviewedAt' in incoming());
      allow get: if isAdmin() || isValidId(submissionId);
      allow list: if isAdmin();
      allow update: if isValidId(submissionId) &&
        isValidProjectSubmission(incoming()) && (
          isAdmin() ||
          (
            existing().submissionStatus in ['draft', 'submitted', 'revision_requested'] &&
            incoming().submissionStatus in ['draft', 'submitted'] &&
            incoming().participantId == existing().participantId &&
            incoming().courseId == existing().courseId &&
            incoming().submissionId == existing().submissionId &&
            (!('moduleId' in existing()) || incoming().moduleId == existing().moduleId) &&
            (!('submissionType' in existing()) || incoming().submissionType == existing().submissionType) &&
            !incoming().diff(existing()).affectedKeys().hasAny([
              'score',
              'rubricScores',
              'reviewerFeedback',
              'coordinatorFeedback',
              'reviewedBy',
              'reviewedAt'
            ])
          )
        );
      allow delete: if isAdmin();
    }

    // 10. Collection: /academyCourseConfig/{configId}
    // Global course visibility, pass mark overrides, and capstone rubric overrides.
    function isValidAcademyCourseConfig(data) {
      return data.keys().hasOnly([
        'publishedOverrides',
        'passMarkOverrides',
        'capstoneRubricOverrides',
        'updatedAt',
        'updatedBy'
      ]) &&
      (!('publishedOverrides' in data) || data.publishedOverrides is map) &&
      (!('passMarkOverrides' in data) || data.passMarkOverrides is map) &&
      (!('capstoneRubricOverrides' in data) || data.capstoneRubricOverrides is map) &&
      (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40)) &&
      (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 100));
    }

    match /academyCourseConfig/{configId} {
      allow get: if configId == 'global' || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && configId == 'global' && isValidAcademyCourseConfig(incoming());
      allow delete: if isAdmin();
    }
  }
}
